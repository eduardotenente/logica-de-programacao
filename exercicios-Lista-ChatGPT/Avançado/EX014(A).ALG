Algoritmo "ex014(A)"
Var

   N, C: Inteiro
   S: Real

Inicio

      Escreva ("Digite um número: ")
      Leia (N)
      Para C <- 1 ate 10 faca
           S <- N / C
           Escreval (N," /",C," = ",S:4:2)
      FimPara

Fimalgoritmo

// Leia um número inteiro positivo N e exiba todos os divisores de N em ordem
// crescente.