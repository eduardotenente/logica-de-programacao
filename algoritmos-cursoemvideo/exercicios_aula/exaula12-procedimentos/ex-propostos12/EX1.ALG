Algoritmo "ex1"
Var

   N, N2, S: Inteiro

Procedimento Somador (num, num2: Inteiro)
Inicio
      S <- num + num2
      Escreval ("A soma entre os números é:",S)
FimProcedimento

Inicio

      Escreva ("Digite um número: ")
      Leia (N)
      Escreva ("Digite outro número: ")
      Leia (N2)
      Somador(N, N2)

Fimalgoritmo