Algoritmo "ex056pdf"

Var

   C, N, S: Inteiro

Inicio

      C <- 1
      S <- 0
      Repita
            Escreva ("Digite o",C,"º número: ")
            Leia (N)
            Escreval (S," +",N)
            C <- C + 1
            S <- S + N
      Ate (N = 1111)
      Escreval ("----------------------")
      Escreval ("O somatório é:",S)

Fimalgoritmo