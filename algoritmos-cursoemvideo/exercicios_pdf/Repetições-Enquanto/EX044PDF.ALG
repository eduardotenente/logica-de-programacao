Algoritmo "ex044pdf"

Var

   I, F, Icre: Inteiro

Inicio

      Escreva ("Valor Inicial: ")
      Leia (I)
      Escreva ("Valor Final: ")
      Leia (F)
      Escreva ("Incremento: ")
      Leia (Icre)

      Enquanto (I <= F) faca
               EscrevaL (I)
               I <- I + Icre
      FimEnquanto

Fimalgoritmo