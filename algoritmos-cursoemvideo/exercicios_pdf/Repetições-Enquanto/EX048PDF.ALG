Algoritmo "ex048pdf"

Var

   C, S, N: Inteiro

Inicio

      C <- 1
      S <- 0
      Enquanto (C <= 7) faca
               Escreva ("Digite um valor: ")
               Leia (N)
               S <- S + N
               C <- C + 1
      FimEnquanto
      EscrevaL ("A soma entre os valores é:",S)

Fimalgoritmo