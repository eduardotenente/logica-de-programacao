Algoritmo "ex042pdf"

Var

   C, Valor: Inteiro

Inicio

      C <- 1
      Escreva ("Até onde contaremos (apenas positivo e Inteiros)? ")
      Leia (Valor)
      Enquanto (C <= Valor) faca
               EscrevaL (C)
               C <- C + 1
      FimEnquanto
      EscrevaL ("Acabou!")

Fimalgoritmo