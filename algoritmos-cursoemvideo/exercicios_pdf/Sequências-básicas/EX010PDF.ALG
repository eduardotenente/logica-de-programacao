Algoritmo "ex010pdf"

Var

   A, L: Inteiro
   area_parede, T: Real

Inicio
 
   Escreva ("Qual é a altura? ")
   Leia (A)
   Escreva ("Qual é a largura? ")
   Leia (L)
   area_parede <- A * L
   T <- area_parede / 2
   Escreval ("A área a ser pintada é", area_parede, "m²")
   Escreva ("Será necessário", T," Litros de tinta")

Fimalgoritmo