Algoritmo "ex013pdf"

Var

   aumento, salario, salario_aumentado: Real

Inicio

      Escreva ("Qual o seu salário? ")
      Leia (salario)
      aumento <- (salario * 15) / 100
      salario_aumentado <- salario + aumento
      Escreva ("Seu salário com 15% de aumento é R$", salario_aumentado)

Fimalgoritmo